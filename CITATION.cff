    family-names: Rao
    email: lee.rao@ucsf.edu
  - given-names: Lani F.
    family-names: Wu
  - given-names: Steven J.
    family-names: Altschuler
preferred-citation:
  type: unpublished
  title: "DUET: Multi-objective optimization of codebooks for barcode-based assays"
  authors:
